{
  "schemaVersion": "1.0",
  "reportId": "customer-certificate",
  "title": "Customer Balance & Solvency Certificate",
  "page": {
    "size": "A4",
    "unit": "mm",
    "orientation": "Portrait",
    "margins": { "top": 18, "right": 18, "bottom": 18, "left": 18 }
  },
  "parameters": [
    { "name": "CertificateNo", "type": "String", "required": true, "defaultValue": "CERT-2026-04419" },
    { "name": "CustomerName", "type": "String", "required": true, "defaultValue": "Rafiqul Islam & Sons (রফিকুল ইসলাম)" },
    { "name": "AccountNo", "type": "String", "required": true, "defaultValue": "1040-883920-001" },
    { "name": "IssueDate", "type": "String", "required": true, "defaultValue": "14 November 2026" }
  ],
  "datasets": [
    {
      "name": "Balances",
      "source": "External",
      "fields": [
        { "name": "Facility", "type": "String" },
        { "name": "AccountRef", "type": "String" },
        { "name": "Currency", "type": "String" },
        { "name": "ClearedBalance", "type": "Decimal" }
      ]
    }
  ],
  "bands": [
    {
      "id": "report-header",
      "type": "ReportHeader",
      "height": 48,
      "elements": [
        { "id": "cert-banner", "type": "Rectangle", "x": 0, "y": 0, "width": 174, "height": 18, "backgroundColor": "#0F172A", "borderColor": "#0F172A" },
        { "id": "cert-bank", "type": "Text", "x": 6, "y": 4, "width": 120, "height": 6, "value": "DHAKA COMMERCIAL BANK PLC", "fontSizePt": 12, "fontWeight": "Bold", "color": "#FFFFFF" },
        { "id": "cert-sub", "type": "Text", "x": 6, "y": 11, "width": 120, "height": 4, "value": "BALANCE & SOLVENCY CERTIFICATE", "fontSizePt": 8.5, "color": "#CBD5E1" },
        { "id": "cert-no", "type": "Text", "x": 6, "y": 24, "width": 90, "height": 5, "expression": "=\"Certificate Ref: \" + Parameters.CertificateNo", "fontSizePt": 9, "fontWeight": "SemiBold", "color": "#0F172A" },
        { "id": "cert-dt", "type": "Text", "x": 96, "y": 24, "width": 78, "height": 5, "expression": "=\"Issued: \" + Parameters.IssueDate", "fontSizePt": 9, "align": "Right", "color": "#475569" },
        { "id": "cert-body", "type": "Text", "x": 6, "y": 33, "width": 162, "height": 10, "expression": "=\"This is to certify that \" + Parameters.CustomerName + \" maintains the following cleared balances as of \" + Parameters.IssueDate + \".\"", "fontSizePt": 9.5, "color": "#1E293B" }
      ]
    },
    {
      "id": "detail-cert",
      "type": "Detail",
      "dataset": "Balances",
      "elements": [
        {
          "id": "cert-table",
          "type": "Table",
          "x": 0,
          "y": 0,
          "width": 174,
          "repeatHeaders": true,
          "columns": [
            { "header": "Account / Facility", "expression": "=Fields.Facility", "width": 66, "align": "Left" },
            { "header": "Account Number", "expression": "=Fields.AccountRef", "width": 52, "align": "Left" },
            { "header": "CCY", "expression": "=Fields.Currency", "width": 18, "align": "Center" },
            { "header": "Cleared Balance", "expression": "=Fields.ClearedBalance", "width": 38, "align": "Right", "format": "N2", "summary": "Sum" }
          ]
        }
      ]
    },
    {
      "id": "report-footer",
      "type": "ReportFooter",
      "height": 34,
      "elements": [
        { "id": "cert-qr", "type": "QrCode", "x": 0, "y": 6, "width": 22, "height": 22, "expression": "=\"CERT|\" + Parameters.CertificateNo + \"|\" + Parameters.AccountNo" },
        { "id": "cert-sig-line", "type": "Line", "x": 116, "y": 20, "width": 58, "height": 0.4, "color": "#475569" },
        { "id": "cert-sig", "type": "Text", "x": 116, "y": 22, "width": 58, "height": 4, "value": "Branch Operations Manager", "fontSizePt": 8, "align": "Center", "color": "#475569" }
      ]
    }
  ]
}
